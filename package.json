{
  "name": "@jk2k/bk",
  "version": "0.2.0",
  "description": "Git-native business knowledge evolution CLI",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "tsx src/cli/index.ts",
    "prepack": "npm run build",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "validate:artifacts": "node --import tsx scripts/validate-artifacts.ts",
    "typecheck:validation": "tsc --noEmit -p tsconfig.validation.json"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "commander": "15.0.0",
    "jsdom": "30.1.3",
    "mermaid": "12.3.0",
    "picomatch": "4.0.7",
    "playwright": "1.64.1",
    "turndown": "7.2.5",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/picomatch": "4.0.3",
    "@types/turndown": "5.0.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "bin": {
    "bk": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "docs/01-PRD.md",
    "docs/02-TECHNICAL-DESIGN.md",
    "docs/IMPLEMENTATION.md",
    "docs/VALIDATION-GAPS.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jk2K/bk.git"
  }
}
